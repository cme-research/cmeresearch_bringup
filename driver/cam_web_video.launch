<launch>
  <arg name="image_view" default="false" />

  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
      <rosparam command="load" file="$(find unico_bringup)/config/ash/usb_cam.yml"/>
  </node>
  <node if="$(arg image_view)" name="image_view" pkg="image_view" type="image_view"
        respawn="false" output="screen">
    <remap from="image" to="/usb_cam/image_raw"/>
    <param name="autosize" value="true" />
  </node>
  <node name="web_video_server" pkg="web_video_server" type="web_video_server_node" output="screen" >
      <rosparam command="load" file="$(find unico_bringup)/config/ash/web_video_server.yml"/>
  </node>
</launch>