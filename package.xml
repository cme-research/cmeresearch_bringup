<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmeresearch_bringup</name>
  <version>0.1.0</version>
  <description>A comprehensive ROS package for robot control, navigation, and simulation with support for multiple robot platforms.
</description>
  <maintainer email="info@cme-robotics.com">cmeresearch</maintainer>
  <author email="info@cme-robotics.com">cmeresearch</author>
  <url type="website">https://cme-robotics.com</url>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- rosbridge WebSocket server: streams /map (and future topics) to the web dashboard's live SLAM viewer -->
  <exec_depend>rosbridge_suite</exec_depend>

  <!--<exec_depend>mqtt_client</exec_depend>-->

  <exec_depend>twist_mux</exec_depend>
  <!--
  <exec_depend>move_base</exec_depend>
  -->
  <!--
  <exec_depend>nav_core</exec_depend>
  -->
  <!--
  <exec_depend>global_planner</exec_depend>
  -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>joy_linux</exec_depend>

  <!--
  <exec_depend>navfn</exec_depend>
  -->
  <!--
  <exec_depend>base_local_planner</exec_depend>
  -->
  <!--
  <exec_depend>dwa_local_planner</exec_depend>
  -->
  <!--
  <exec_depend>costmap_2d</exec_depend>
  -->
  <exec_depend>tf2_ros</exec_depend>
  <!--
  <exec_depend>slam_toolbox</exec_depend>
  -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <!--
  <exec_depend>mrpt_map_server</exec_depend> --> <!-- map_server not available -->
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>




